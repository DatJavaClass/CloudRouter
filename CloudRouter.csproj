<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CloudRouter</AssemblyName>
    <RootNamespace>CloudRouter</RootNamespace>
    <Product>Cloud Router</Product>
    <AssemblyTitle>Cloud Router</AssemblyTitle>
    <Authors>Victor S. (DatJavaClass)</Authors>
    <Description>Route files into cloud and remote folders from the Windows right-click menu.</Description>
    <Version>1.0.0</Version>
    <!-- Reproducible build, no machine/user paths baked into the binary. -->
    <Deterministic>true</Deterministic>
    <!-- The shell never sees a console window: WinExe + no console output. -->
  </PropertyGroup>

  <!-- Release ships no PDB, so no local source paths leak into published binaries. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Update="destinations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
