<Window x:Class="CloudRouter.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloud Router Setup" Height="580" Width="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F3F3F3">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Cloud Router" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,14" Foreground="#555" TextWrapping="Wrap"
                   Text="Tick the folders you want in the right-click menu. Add any other local folder with &quot;Add folder...&quot;. For a drive root you don't want cluttered, set a Subfolder (e.g. Inbox) and everything routed there lands inside it."/>

        <DataGrid Grid.Row="2" x:Name="DestGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  Background="White" BorderBrush="#DDDDDD" SelectionMode="Single"
                  CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Width="44"
                                        Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Name" Width="190" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Folder" Width="*" Binding="{Binding Path}"/>
                <DataGridTextColumn Header="Subfolder" Width="130" Binding="{Binding Subfolder}"/>
                <DataGridTextColumn Header="Source" Width="90" IsReadOnly="True" Binding="{Binding Provider}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="AddBtn" Content="Add folder..." Padding="14,6" Click="AddFolder_Click"/>
            <Button x:Name="RemoveBtn" Content="Remove" Padding="14,6" Margin="8,0,0,0" Click="Remove_Click"/>
            <TextBlock Text="Action:" VerticalAlignment="Center" Margin="28,0,8,0"/>
            <RadioButton x:Name="MoveRadio" Content="Move" GroupName="act" IsChecked="True" VerticalAlignment="Center"/>
            <RadioButton x:Name="CopyRadio" Content="Copy" GroupName="act" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="Status" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#367C2B" TextWrapping="Wrap" MaxWidth="430"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallBtn" Content="Install" Padding="22,8" FontWeight="SemiBold" Click="Install_Click"/>
                <Button x:Name="CloseBtn" Content="Close" Padding="18,8" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
